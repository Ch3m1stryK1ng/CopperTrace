  "pattern_sinks": [
    {
      "name": "pointer_store",
      "enabled": true,
      "label": "STORE_SINK",
      "kind": "store_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/miners/additional_sinks.py:502",
      "patterns": ["store via ARG pointer", "store via GLOBAL_PTR", "store via UNKNOWN pointer"],
      "roles": {"dst": "store target", "value": "rhs"},
      "requires_detector": "memory_access_or_statement_store_detector"
    },
    {
      "name": "param_store",
      "enabled": true,
      "label": "STORE_SINK",
      "kind": "store_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/miners/additional_sinks.py:607",
      "patterns": ["*param_N = ...", "*(type *)(param_N + off) = ...", "param_N[index] = ...", "semantic pointer parameter field store"],
      "roles": {"dst": "param-derived location", "value": "rhs"},
      "requires_detector": "decompiled_statement_pattern_detector"
    },
    {
      "name": "field_update_store",
      "enabled": true,
      "label": "STORE_SINK",
      "kind": "store_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/miners/additional_sinks.py:607",
      "patterns": [
        "object->field = input_derived_local + object->field",
        "(object->subobject).field = value",
        "object->field += input_derived_local"
      ],
      "roles": {"dst": "field store target", "value": "rhs"},
      "requires_detector": "decompiled_statement_pattern_detector",
      "emission_rule": "emit STORE_SINK when a local scalar is first copied from an input buffer and then used in a field update; otherwise leave for semantic review"
    },
    {
      "name": "loop_write",
      "enabled": true,
      "label": "LOOP_WRITE_SINK",
      "kind": "loop_write_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/miners/additional_sinks.py:758",
      "patterns": ["for/while/do loop containing indexed store", "pointer arithmetic store in loop", "*dst++ = value"],
      "roles": {"dst": "store expression", "index": "index expression", "bound": "loop bound"},
      "requires_detector": "loop_body_store_detector"
    },
    {
      "name": "loop_copy",
      "enabled": true,
      "label": "COPY_SINK",
      "kind": "loop_copy_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/miners/additional_sinks.py:1131",
      "patterns": ["dst[i] = src[i]", "*dst++ = *src++"],
      "roles": {"dst": "loop destination", "src": "loop source", "len": "loop bound or index range"},
      "requires_detector": "loop_copy_idiom_detector"
    },
    {
      "name": "parser_field_store",
      "enabled": true,
      "label": "PARSING_OVERFLOW_SINK",
      "kind": "parser_store_pattern_sink",
      "patterns": ["struct_field = buf[offset]", "struct_field = *(type *)(buf + off)", "parsed field later used as parser bound"],
      "roles": {"dst": "parser state field", "src": "input buffer byte/region", "len": "parsed length/bound field when present"},
      "requires_detector": "parser_store_statement_detector",
      "emission_rule": "emit semantic candidate; LLM/review must confirm sink semantics"
    },
    {
      "name": "unbounded_walk",
      "enabled": true,
      "label": "UNBOUNDED_WALK_SINK",
      "kind": "parser_walk_pattern_sink",
      "patterns": ["p = p + *p + const", "p = p + len + const followed by *p", "packet pointer walk without proven end guard"],
      "roles": {"dst": "advanced pointer", "len": "data-derived step", "guard": "end/capacity guard if present"},
      "requires_detector": "unbounded_parser_walk_detector",
      "emission_rule": "emit semantic candidate; LLM/review must confirm sink semantics"
    },
    {
      "name": "nonliteral_format",
      "enabled": true,
      "label": "FORMAT_STRING_SINK",
      "kind": "format_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/miners/format_string_sink.py:33",
      "format_functions": ["printf", "fprintf", "sprintf", "snprintf", "vprintf", "vfprintf", "vsprintf", "vsnprintf", "syslog"],
      "roles": {"fmt": "format argument", "dst": "destination buffer when present", "len": "bound argument when present"},
      "emission_rule": "emit only when format argument is non-literal or unresolved",
      "requires_detector": "format_argument_literal_detector"
    },
    {
      "name": "indirect_call_control",
      "enabled": true,
      "label": "FUNC_PTR_SINK",
      "kind": "control_flow_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/miners/func_ptr_sink.py:35",
      "patterns": ["indexed function table dispatch", "function pointer parameter call", "computed/casted indirect call", "table[index](...)"],
      "roles": {"target": "function pointer expression", "index": "dispatch index when present"},
      "requires_detector": "indirect_call_taint_or_index_detector"
    },
    {
      "name": "double_free",
      "enabled": true,
      "label": "LIFETIME_SINK",
      "kind": "lifetime_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/miners/additional_sinks.py:1844",
      "patterns": ["free(ptr) followed by free(ptr)"],
      "roles": {"object": "freed pointer"},
      "requires_detector": "lifetime_sequence_detector"
    },
    {
      "name": "use_after_free",
      "enabled": true,
      "label": "LIFETIME_SINK",
      "kind": "lifetime_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/miners/additional_sinks.py:1844",
      "patterns": ["free(ptr) followed by ptr dereference"],
      "roles": {"object": "freed pointer", "use": "post-free dereference"},
      "requires_detector": "lifetime_sequence_detector"
    },
    {
      "name": "casted_pointer_deref",
      "enabled": true,
      "label": "LIFETIME_SINK",
      "kind": "lifetime_or_type_confusion_pattern_sink",
      "sourceagent_reference": "sourceagent/pipeline/chain_artifacts.py:1769",
      "patterns": ["ptr = (type *)source; ptr->field"],
      "roles": {"object": "casted pointer", "source": "source expression", "field": "dereferenced field"},
      "requires_detector": "casted_pointer_deref_detector"
    }
  ],
  "dispatch_patterns": [
    {"name": "casted_function_pointer_call", "enabled": true, "status": "unresolved_dispatch_only"},
    {"name": "function_pointer_call", "enabled": true, "status": "unresolved_dispatch_only"}
  ]
}
