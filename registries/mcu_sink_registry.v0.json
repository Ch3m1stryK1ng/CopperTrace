{
  "schema_version": "ct-mini-sink-registry-v0",
  "name": "mcu_sink_registry",
  "description": "Pre-defined sink registry for MCU firmware sink pre-work. Entries are sink seeds, not vulnerability verdicts.",
  "policy": {
    "enabled_only": true,
    "front_pipeline_llm": false,
    "no_exact_sample_or_cve_function_shortcuts": true,
    "decisions": {
      "ACCEPT_DETERMINISTIC": "Primitive, compiler intrinsic, or body-proved wrapper semantics with bound roles.",
      "ACCEPT_HEURISTIC": "Generalized STORE/loop/parser structure retained as a backward-DFA startpoint.",
      "DROP_LOCAL_HEURISTIC": "The site does not satisfy the local admission threshold; this is not proof that it can never be a sink.",
      "DROP_PROVEN": "A local contradiction proves that the observed site is not a sink of the nominated class."
    },
    "meaning": {
      "primitive_sinks": "Low-level C/library/compiler routines that directly write/copy/format memory.",
      "framework_sinks": "RTOS/network/framework APIs with known argument roles. These supplement body-derived wrappers.",
      "pattern_sinks": "Code-shape sink types inherited from CopperTrace miners. These require pattern/dataflow detectors, not only name scanning.",
      "dispatch_patterns": "Indirect call shapes recorded as unresolved dispatch edges unless their targets are resolved later."
    },
    "default_vulnerable_parameter_roles_by_label": {
      "COPY_SINK": ["src", "len"],
      "MEMSET_SINK": ["len"],
      "STORE_SINK": ["dst", "value"],
      "LOOP_WRITE_SINK": ["dst", "src", "value", "len", "index", "bound"],
      "FORMAT_STRING_SINK": ["fmt"],
      "FUNC_PTR_SINK": ["target", "index"],
      "LIFETIME_SINK": ["object"]
    }
  },
  "sink_labels": [
    {
      "label": "COPY_SINK",
      "enabled": true,
      "sourceagent_definition": "sourceagent/pipeline/models.py:33",
      "meaning": "Memory/string copy, copy-like loop, or framework buffer append/copy where dst/src/len roles can be recovered.",
      "detectors": ["primitive_sinks", "framework_sinks", "body_derived_wrappers", "pattern_sinks.loop_copy"]
    },
    {
      "label": "MEMSET_SINK",
      "enabled": true,
      "sourceagent_definition": "sourceagent/pipeline/models.py:34",
      "meaning": "Memory fill/clear where dst/value/len roles can be recovered.",
      "detectors": ["primitive_sinks"]
    },
    {
      "label": "STORE_SINK",
      "enabled": true,
      "sourceagent_definition": "sourceagent/pipeline/models.py:35",
      "meaning": "Store through argument/global/unknown pointer or queue/message API that writes an object into shared state.",
      "detectors": ["framework_sinks.queue", "pattern_sinks.pointer_store", "pattern_sinks.param_store"]
    },
    {
      "label": "LOOP_WRITE_SINK",
      "enabled": true,
      "sourceagent_definition": "sourceagent/pipeline/models.py:36",
      "meaning": "Loop that writes to memory each iteration, especially indexed or pointer-increment writes.",
      "detectors": ["pattern_sinks.loop_write"]
    },
    {
      "label": "FORMAT_STRING_SINK",
      "enabled": true,
      "sourceagent_definition": "sourceagent/pipeline/models.py:37",
      "meaning": "Printf-family call where the format argument is variable/non-literal, plus buffer-formatting calls with dst/fmt roles.",
      "detectors": ["primitive_sinks.format_buffer", "pattern_sinks.nonliteral_format"]
    },
    {
      "label": "FUNC_PTR_SINK",
      "enabled": true,
      "sourceagent_definition": "sourceagent/pipeline/models.py:38",
      "meaning": "Indirect call where function pointer or dispatch index may be attacker-controlled.",
      "detectors": ["pattern_sinks.indirect_call_control"]
    },
    {
      "label": "LIFETIME_SINK",
      "enabled": true,
      "sourceagent_definition": "sourceagent/pipeline/models.py:39",
      "meaning": "Double-free, use-after-free, or related object lifetime misuse visible in decompiled code.",
      "detectors": ["pattern_sinks.double_free", "pattern_sinks.use_after_free", "pattern_sinks.casted_pointer_deref"]
    }
  ],
  "primitive_sinks": [
    {"name": "memcpy", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "memmove", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "bcopy", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "src_arg": 0, "dst_arg": 1, "len_arg": 2},
    {"name": "__aeabi_memcpy", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "__aeabi_memcpy4", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
