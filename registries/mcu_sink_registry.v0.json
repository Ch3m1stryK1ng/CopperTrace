    {"name": "__aeabi_memmove4", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "__aeabi_memmove8", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "__rt_memcpy", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "__rt_memmove", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "__memcpy_r4", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "__memcpy_r7", "enabled": true, "kind": "primitive_memory_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "memset", "enabled": true, "kind": "primitive_memory_sink", "label": "MEMSET_SINK", "dst_arg": 0, "value_arg": 1, "len_arg": 2},
    {"name": "bzero", "enabled": true, "kind": "primitive_memory_sink", "label": "MEMSET_SINK", "dst_arg": 0, "len_arg": 1},
    {"name": "__aeabi_memset", "enabled": true, "kind": "primitive_memory_sink", "label": "MEMSET_SINK", "dst_arg": 0, "len_arg": 1, "value_arg": 2},
    {"name": "__aeabi_memclr", "enabled": true, "kind": "primitive_memory_sink", "label": "MEMSET_SINK", "dst_arg": 0, "len_arg": 1, "value_expr": "0"},
    {"name": "strcpy", "enabled": true, "kind": "primitive_string_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1},
    {"name": "strncpy", "enabled": true, "kind": "primitive_string_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "strlcpy", "enabled": true, "kind": "primitive_string_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "strcat", "enabled": true, "kind": "primitive_string_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1},
    {"name": "strncat", "enabled": true, "kind": "primitive_string_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2},
    {"name": "sprintf", "enabled": true, "kind": "primitive_format_sink", "label": "FORMAT_STRING_SINK", "dst_arg": 0, "fmt_arg": 1},
    {"name": "snprintf", "enabled": true, "kind": "primitive_format_sink", "label": "FORMAT_STRING_SINK", "dst_arg": 0, "len_arg": 1, "fmt_arg": 2},
    {"name": "vsprintf", "enabled": true, "kind": "primitive_format_sink", "label": "FORMAT_STRING_SINK", "dst_arg": 0, "fmt_arg": 1},
    {"name": "vsnprintf", "enabled": true, "kind": "primitive_format_sink", "label": "FORMAT_STRING_SINK", "dst_arg": 0, "len_arg": 1, "fmt_arg": 2}
  ],
  "framework_sinks": [
    {"name": "net_buf_simple_add_mem", "enabled": true, "framework": "zephyr", "kind": "framework_copy_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2, "vulnerable_parameter_roles": ["src", "len"]},
    {"name": "net_buf_add_mem", "enabled": true, "framework": "zephyr", "kind": "framework_copy_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2, "vulnerable_parameter_roles": ["src", "len"]},
    {"name": "net_buf_simple_pull", "enabled": true, "framework": "zephyr", "kind": "framework_buffer_state_sink", "label": "COPY_SINK", "dst_arg": 0, "len_arg": 1, "vulnerable_parameter_roles": ["len"]},
    {"name": "net_buf_pull", "enabled": true, "framework": "zephyr", "kind": "framework_buffer_state_sink", "label": "COPY_SINK", "dst_arg": 0, "len_arg": 1, "vulnerable_parameter_roles": ["len"]},
    {"name": "net_buf_simple_add", "enabled": true, "framework": "zephyr", "kind": "framework_buffer_state_sink", "label": "COPY_SINK", "dst_arg": 0, "len_arg": 1, "vulnerable_parameter_roles": ["len"]},
    {"name": "net_buf_add", "enabled": true, "framework": "zephyr", "kind": "framework_buffer_state_sink", "label": "COPY_SINK", "dst_arg": 0, "len_arg": 1, "vulnerable_parameter_roles": ["len"]},
    {"name": "sys_mem_swap", "enabled": true, "framework": "zephyr", "kind": "framework_memory_mutation_sink", "label": "LOOP_WRITE_SINK", "dst_arg": 0, "len_arg": 1, "vulnerable_parameter_roles": ["dst", "len"]},
    {"name": "ring_buf_put", "enabled": true, "framework": "zephyr", "kind": "framework_copy_sink", "label": "COPY_SINK", "dst_arg": 0, "src_arg": 1, "len_arg": 2, "vulnerable_parameter_roles": ["src", "len"]},
    {"name": "ring_buf_get", "enabled": true, "framework": "zephyr", "kind": "framework_copy_sink", "label": "COPY_SINK", "dst_arg": 1, "src_arg": 0, "len_arg": 2, "vulnerable_parameter_roles": ["dst", "len"]},
    {"name": "k_msgq_put", "enabled": true, "framework": "zephyr", "kind": "framework_queue_sink", "label": "STORE_SINK", "dst_arg": 0, "src_arg": 1, "vulnerable_parameter_roles": ["src"]},
    {"name": "k_msgq_get", "enabled": true, "framework": "zephyr", "kind": "framework_queue_sink", "label": "STORE_SINK", "dst_arg": 1, "src_arg": 0, "vulnerable_parameter_roles": ["dst"]},
    {"name": "packetbuf_copyfrom", "enabled": true, "framework": "contiki", "kind": "framework_copy_sink", "label": "COPY_SINK", "src_arg": 0, "len_arg": 1, "dst_expr": "packetbuf", "vulnerable_parameter_roles": ["src", "len"]},
    {"name": "packetbuf_copyto", "enabled": true, "framework": "contiki", "kind": "framework_copy_sink", "label": "COPY_SINK", "dst_arg": 0, "src_expr": "packetbuf", "vulnerable_parameter_roles": ["dst"]},
