    {"name": "pbuf_copy_partial", "enabled": true, "framework": "lwip", "kind": "framework_copy_sink", "label": "COPY_SINK", "src_arg": 0, "dst_arg": 1, "len_arg": 2, "vulnerable_parameter_roles": ["src", "len"]},
    {"name": "xQueueSend", "enabled": true, "framework": "freertos", "kind": "framework_queue_sink", "label": "STORE_SINK", "dst_arg": 0, "src_arg": 1, "vulnerable_parameter_roles": ["src"]},
    {"name": "xQueueSendToBack", "enabled": true, "framework": "freertos", "kind": "framework_queue_sink", "label": "STORE_SINK", "dst_arg": 0, "src_arg": 1, "vulnerable_parameter_roles": ["src"]},
