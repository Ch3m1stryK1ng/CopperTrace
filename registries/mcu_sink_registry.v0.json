    {"name": "osMessageQueueGet", "enabled": true, "framework": "cmsis_rtos2", "kind": "framework_queue_sink", "label": "STORE_SINK", "dst_arg": 1, "src_arg": 0, "vulnerable_parameter_roles": ["dst"]}
