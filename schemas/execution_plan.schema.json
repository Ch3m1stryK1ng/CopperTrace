{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coppertrace.local/schemas/execution_plan.schema.json",
  "title": "CopperTrace Mini execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "alert_id",
    "binary_sha256",
    "source_binding",
    "input_templates",
    "events",
    "ordering_constraints",
    "sink_checkpoint",
    "expected_invalid_effects",
    "replay_count",
    "unresolved_assumptions",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"const": "ct-mini-execution-plan-v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "alert_id": {"type": "string", "minLength": 1},
    "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_site_id", "delivery", "hardware_source_ids", "register_addresses"],
      "properties": {
        "source_id": {"type": "string"},
        "source_site_id": {"type": "string"},
        "delivery": {"enum": ["MMIO", "SOFTWARE_INTERFACE"]},
        "hardware_source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "register_addresses": {"type": "array", "items": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"}, "uniqueItems": true}
      }
    },
    "input_templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template_id", "byte_length", "fill_byte", "payload_start", "payload_start_evidence_ref", "fields", "concretization_limit"],
        "properties": {
          "template_id": {"type": "string", "minLength": 1},
          "byte_length": {"type": "integer", "minimum": 1, "maximum": 4096},
          "fill_byte": {"type": "integer", "minimum": 0, "maximum": 255},
          "payload_start": {"type": ["integer", "null"], "minimum": 0, "maximum": 4095},
          "payload_start_evidence_ref": {"type": ["string", "null"]},
          "concretization_limit": {"type": "integer", "minimum": 1, "maximum": 16},
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "role", "offset", "size", "encoding", "candidates", "evidence_ref"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "role": {"enum": ["packet_type", "header", "len", "payload", "other"]},
                "offset": {"type": "integer", "minimum": 0},
                "size": {"type": "integer", "minimum": 1, "maximum": 256},
                "encoding": {"enum": ["uint_le", "uint_be", "bytes_hex"]},
                "candidates": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": ["integer", "string"]}},
                "evidence_ref": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "kind", "order", "template_id", "register_address", "irq", "trigger_address"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["SOURCE_PAYLOAD", "INTERRUPT", "DELAY"]},
          "order": {"type": "integer", "minimum": 0},
          "template_id": {"type": ["string", "null"]},
          "register_address": {"type": ["string", "null"]},
          "irq": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
          "trigger_address": {"type": ["string", "null"]}
        }
      }
    },
    "ordering_constraints": {"type": "array", "items": {"type": "string"}, "maxItems": 32},
    "sink_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sink_id", "effect_site_id", "effect_address", "boundary_site_ids", "vulnerable_parameter_roles"],
      "properties": {
        "sink_id": {"type": "string"},
        "effect_site_id": {"type": "string"},
        "effect_address": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
        "boundary_site_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "vulnerable_parameter_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "expected_invalid_effects": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["INVALID_READ", "INVALID_WRITE", "UNMAPPED_ACCESS", "ILLEGAL_INSTRUCTION", "CONTROL_FLOW_FAULT", "CRASH"]},
      "uniqueItems": true
    },
    "replay_count": {"type": "integer", "minimum": 2, "maximum": 5},
    "unresolved_assumptions": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
